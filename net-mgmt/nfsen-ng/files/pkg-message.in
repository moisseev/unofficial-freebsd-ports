[
{ type: install
  message: <<EOM
 - To enable nfsen-ng, add the following line to /etc/rc.conf:

     nfsen_ng_enable="YES"

   or run:

     service nfsen-ng enable

 - Edit the configuration file:

     /usr/local/www/nfsen-ng/backend/settings/settings.php

   (copied from settings.php.sample on install; set your nfdump
   profiles-data directory and sources)

 - Then run:

     cd /usr/local/www/nfsen-ng && composer install --no-dev

 - When using the Apache web server, make sure it reads the shipped
   .htaccess file (AllowOverride All). With nginx, configure an
   equivalent rewrite of /api/ to backend/index.php.

 - Note: nfsen-ng does not start nfcapd.
   It expects the profiles-data directory structure to be:

     PROFILES_DATA_PATH/PROFILE/SOURCE/YYYY/MM/DD/nfcapd.YYYYMMDDHHII

   Example:

     /var/nfdump/profiles_data/live/source1/2018/12/01/nfcapd.201812010225
EOM
}
]
